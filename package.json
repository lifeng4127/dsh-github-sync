{
  "name": "dsh-github-sync",
  "version": "0.5.1",
  "description": "把 DSH 会话与工作区文件夹同步到私有 GitHub 仓，用于跨设备接力（Windows / macOS）。",
  "type": "module",
  "license": "MIT",
  "author": "mount9527",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mount9527/dsh-github-sync.git"
  },
  "homepage": "https://github.com/mount9527/dsh-github-sync#readme",
  "bugs": {
    "url": "https://github.com/mount9527/dsh-github-sync/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "sync",
    "cross-device",
    "handoff"
  ],
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "lib/*.mjs",
    "README.md",
    "README.en.md",
    "TUTORIAL.md",
    "RELEASE_NOTES.md",
    "CHANGELOG.md",
    "LICENSE",
    "PUBLISHING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
